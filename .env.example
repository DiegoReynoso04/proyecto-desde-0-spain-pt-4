# =====================================================================
# TallerYA — variables de entorno
# Plantilla SIN valores reales (sí se sube a git).
# Cópiala a .env (que NUNCA se sube) y rellena los valores marcados con <<< RELLENAR.
# =====================================================================

# ---------- General ----------
APP_NAME=TallerYA
# development | test | production
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
TZ=Europe/Madrid
DEFAULT_LOCALE=es-ES
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
# Puertos publicados en tu máquina (cámbialos si ya están ocupados)
BACKEND_PORT=8000
FRONTEND_PORT=3000
ADMINER_PORT=8080

# ---------- Supabase (solo como PostgreSQL) ----------
SUPABASE_URL=https://hfhjwuvpxdfeidvjedai.supabase.co
SUPABASE_PROJECT_REF=hfhjwuvpxdfeidvjedai
# Contraseña de la BD: panel de Supabase > Project Settings > Database.
# Si tiene caracteres especiales (@ : / ? # % &), codifícala en la URL de abajo (p. ej. @ -> %40).
SUPABASE_DB_PASSWORD=
# Copia la URL exacta del panel: botón "Connect" > "Session pooler" (puerto 5432).
# Sustituye aws-<n>-<region> por el host que te muestre el panel y [PASSWORD] por tu contraseña.
DATABASE_URL=postgresql+psycopg://postgres.hfhjwuvpxdfeidvjedai:[PASSWORD]@aws-<n>-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_SCHEMA=tallerya
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_ECHO=false

# ---------- PostgreSQL local (solo tests, contenedor "db") ----------
POSTGRES_USER=tallerya
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tallerya_test
# puerto expuesto en tu máquina (5432 dentro de Docker)
POSTGRES_PORT=5433
TEST_DATABASE_URL=postgresql+psycopg://tallerya:change-me@db:5432/tallerya_test

# ---------- Seguridad / autenticación ----------
# Genera cada secreto con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
JWT_REFRESH_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_SECRET_KEY=change-me
CSRF_SECRET_KEY=change-me
# true en producción (HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=localhost
CORS_ORIGINS=http://localhost:3000
LOGIN_RATE_LIMIT=5/minute
CONTACT_RATE_LIMIT=3/minute
LOGIN_LOCKOUT_MINUTES=15

# ---------- Reglas de negocio ----------
RESERVATION_HOLD_HOURS=24
COURSE_MAX_CAPACITY=10
EXPIRATION_JOB_INTERVAL_MINUTES=5
REMINDER_HOURS_BEFORE=24
CURRENCY=EUR

# ---------- Pago simulado ----------
PAYMENT_PROVIDER=simulated
PAYMENT_SIMULATION_SECRET=change-me

# ---------- Email (Mailpit en desarrollo) ----------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM="TallerYA <no-reply@tallerya.local>"
OWNER_NOTIFICATION_EMAIL=dueno@example.com
MAILPIT_UI_PORT=8025

# ---------- Usuario admin inicial (seed) ----------
SEED_ADMIN_NAME=Dueño TallerYA
SEED_ADMIN_EMAIL=admin@tallerya.local
SEED_ADMIN_PASSWORD=change-me

# ---------- Frontend (Next.js) ----------
# Las NEXT_PUBLIC_* son públicas (van al navegador): nunca pongas secretos aquí.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE=/api/v1
# usado por los rewrites de Next dentro de Docker
API_INTERNAL_URL=http://backend:8000
NEXT_TELEMETRY_DISABLED=1
# hot reload en Docker sobre Windows
WATCHPACK_POLLING=true

# ---------- Bancos de imágenes (opcional) ----------
# Solo si quieres que Claude Code busque imágenes por API. Sin clave, las descarga a mano.
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
